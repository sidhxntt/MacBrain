# MacBrain has no required environment variables or cloud API keys.
#
# This optional flag enables the live local-Ollama integration tests. It requires
# Ollama to be installed and running locally. Keep it at 0 for normal test runs.
MACBRAIN_LIVE_OLLAMA=0

# Optional: override the Keychain code-signing identity used by the local build
# script. The default is "MacBrain Local Code Signing" when it exists.
# MACBRAIN_SIGNING_IDENTITY="MacBrain Local Code Signing"
